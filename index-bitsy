<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bitsy Jam — Class Portal</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg-page: #012E40;
  --bg-surface: #034959;
  --bg-card: #02384D;
  --bg-input: #02384D;
  --border-subtle: #0A5068;
  --border-mid: #14607A;

  --pixel-purple: #9784D9;
  --pixel-cyan: #5BBCD6;
  --pixel-yellow: #F2DD72;
  --pixel-green: #7CD9A0;
  --pixel-pink: #F28972;
  --pixel-orange: #E85B5B;

  --text-body: #C5D1D8;
  --text-strong: #EDF0F2;
  --text-muted: #6B8A97;

  --font-pixel: 'IBM Plex Sans', sans-serif;
  --font-body: 'Source Sans 3', sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { height: 100%; scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--bg-page);
  color: var(--text-body);
  line-height: 1.7;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── SCANLINE OVERLAY ── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 3px,
    rgba(0,0,0,0.07) 3px,
    rgba(0,0,0,0.07) 4px
  );
  pointer-events: none;
  z-index: 9999;
}

/* ── HEADER ── */
.page-header {
  padding: 1.25rem 2rem 0 2rem;
  flex-shrink: 0;
  border-bottom: 2px solid var(--border-subtle);
  background: linear-gradient(180deg, rgba(1,46,64,1) 0%, rgba(1,46,64,0.9) 100%);
}
.header-inner { max-width: 900px; margin: 0 auto; display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 0.75rem; }
.header-left {}
.site-title {
  font-family: var(--font-pixel);
  color: var(--pixel-yellow);
  font-size: 1.1rem;
  line-height: 1.4;
  text-shadow: 3px 3px 0 #7c3aed, 6px 6px 0 rgba(120,100,170,0.3);
  margin-bottom: 0.35rem;
}
.site-subtitle {
  font-family: var(--font-body);
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.session-badge {
  font-family: var(--font-pixel);
  font-size: 0.5rem;
  color: var(--pixel-cyan);
  background: rgba(91,188,214,0.1);
  border: 1px solid var(--pixel-cyan);
  padding: 0.4rem 0.7rem;
  border-radius: 4px;
  line-height: 1.8;
}

/* ── TAB BAR ── */
.tab-bar {
  padding: 0 2rem;
  flex-shrink: 0;
  overflow-x: auto;
  scrollbar-width: none;
  background: var(--bg-page);
}
.tab-bar::-webkit-scrollbar { display: none; }
.tab-bar-inner {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  gap: 3px;
  padding-top: 0.75rem;
}
.tab-btn {
  font-family: var(--font-pixel);
  font-size: 0.5rem;
  padding: 0.65rem 1rem;
  border: 2px solid var(--border-subtle);
  border-bottom: none;
  border-radius: 6px 6px 0 0;
  background: rgba(2,56,77,0.4);
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.15s;
  white-space: nowrap;
  flex: 1;
  text-align: center;
  line-height: 1.6;
}
.tab-btn:hover { background: var(--bg-surface); color: var(--text-body); border-color: var(--border-mid); }
.tab-btn.active { background: var(--bg-surface); color: var(--pixel-yellow); border-color: var(--pixel-yellow); }
.tab-btn.active.art { color: var(--pixel-pink); border-color: var(--pixel-pink); }
.tab-btn.active.design { color: var(--pixel-green); border-color: var(--pixel-green); }
.tab-btn.active.tools { color: var(--pixel-cyan); border-color: var(--pixel-cyan); }
.tab-btn.stub { opacity: 0.5; }

/* ── CONTENT WRAPPER ── */
.tab-content-wrapper {
  flex: 1;
  overflow: hidden;
  border-top: 2px solid var(--border-subtle);
}
.tab-panel {
  display: none;
  height: 100%;
  overflow-y: auto;
  padding: 1.5rem 2rem 3rem 2rem;
  scrollbar-width: thin;
  scrollbar-color: var(--border-mid) transparent;
}
.tab-panel::-webkit-scrollbar { width: 5px; }
.tab-panel::-webkit-scrollbar-thumb { background: var(--border-mid); border-radius: 3px; }
.tab-panel.active { display: block; }
.tab-panel-inner { max-width: 900px; margin: 0 auto; }

/* ── TYPOGRAPHY ── */
h2 {
  font-family: var(--font-pixel);
  font-size: 0.75rem;
  line-height: 1.8;
  margin: 0 0 1rem 0;
  color: var(--pixel-yellow);
}
h3 {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 800;
  color: var(--text-strong);
  margin: 1.25rem 0 0.5rem 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
p { margin-bottom: 1rem; font-size: 1rem; }
strong { color: var(--text-strong); }

/* ── HUB TAB ── */
.hub-intro {
  background: linear-gradient(135deg, rgba(151,132,217,0.12), rgba(91,188,214,0.06));
  border: 2px solid var(--pixel-purple);
  border-radius: 10px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1.5rem;
}
.hub-intro p { margin: 0; font-size: 1.05rem; color: var(--text-strong); }

.nav-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  margin: 1.25rem 0;
}
.nav-card {
  background: var(--bg-card);
  border: 2px solid var(--border-subtle);
  border-radius: 10px;
  padding: 1.1rem;
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
}
.nav-card:hover { transform: translateY(-2px); }
.nav-card.art { border-color: var(--pixel-pink); }
.nav-card.art:hover { background: rgba(242,137,114,0.08); box-shadow: 0 4px 20px rgba(242,137,114,0.2); }
.nav-card.design { border-color: var(--pixel-green); }
.nav-card.design:hover { background: rgba(124,217,160,0.08); box-shadow: 0 4px 20px rgba(124,217,160,0.2); }
.nav-card.tools { border-color: var(--pixel-cyan); }
.nav-card.tools:hover { background: rgba(91,188,214,0.08); box-shadow: 0 4px 20px rgba(91,188,214,0.2); }
.nav-card-icon { font-size: 1.8rem; margin-bottom: 0.5rem; }
.nav-card-title {
  font-family: var(--font-pixel);
  font-size: 0.5rem;
  line-height: 1.8;
  margin-bottom: 0.35rem;
}
.nav-card.art .nav-card-title { color: var(--pixel-pink); }
.nav-card.design .nav-card-title { color: var(--pixel-green); }
.nav-card.tools .nav-card-title { color: var(--pixel-cyan); }
.nav-card-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; }

.qr-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  padding: 1.1rem 1.25rem;
  margin-top: 1.25rem;
}
.qr-placeholder {
  width: 80px;
  height: 80px;
  border: 2px solid var(--pixel-yellow);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg-card);
  font-size: 1.5rem;
}
.qr-text { font-size: 0.9rem; }
.qr-text strong { color: var(--pixel-yellow); display: block; margin-bottom: 0.2rem; }
.qr-url {
  font-family: var(--font-pixel);
  font-size: 0.45rem;
  color: var(--pixel-cyan);
  line-height: 2;
  word-break: break-all;
}

/* ── ART TAB: TERM CARDS ── */
.term-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}
.term-card {
  background: var(--bg-card);
  border: 2px solid var(--border-subtle);
  border-radius: 10px;
  padding: 1.1rem;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.term-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}
.term-card.texture::before { background: var(--pixel-orange); }
.term-card.scale::before { background: var(--pixel-cyan); }
.term-card.perspective::before { background: var(--pixel-purple); }
.term-card.color::before { background: var(--pixel-pink); }

.term-card:hover { transform: translateY(-2px); border-color: var(--border-mid); }
.term-card.active { border-color: var(--border-mid); }
.term-card.texture.active { border-color: var(--pixel-orange); background: rgba(232,91,91,0.06); }
.term-card.scale.active { border-color: var(--pixel-cyan); background: rgba(91,188,214,0.06); }
.term-card.perspective.active { border-color: var(--pixel-purple); background: rgba(151,132,217,0.06); }
.term-card.color.active { border-color: var(--pixel-pink); background: rgba(242,137,114,0.06); }

.term-label {
  font-family: var(--font-pixel);
  font-size: 0.55rem;
  line-height: 1.8;
  margin-bottom: 0.4rem;
}
.term-card.texture .term-label { color: var(--pixel-orange); }
.term-card.scale .term-label { color: var(--pixel-cyan); }
.term-card.perspective .term-label { color: var(--pixel-purple); }
.term-card.color .term-label { color: var(--pixel-pink); }

.term-teaser { font-size: 0.82rem; color: var(--text-muted); line-height: 1.4; }
.term-cta {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
.term-card.active .term-cta { display: none; }

/* ── TERM DETAIL PANEL ── */
.term-detail {
  display: none;
  background: var(--bg-surface);
  border: 2px solid var(--border-mid);
  border-radius: 10px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  animation: slideDown 0.2s ease;
}
.term-detail.visible { display: block; }
@keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }

.term-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.term-detail-title {
  font-family: var(--font-pixel);
  font-size: 0.65rem;
  line-height: 1.8;
}
.term-detail.texture .term-detail-title { color: var(--pixel-orange); }
.term-detail.scale .term-detail-title { color: var(--pixel-cyan); }
.term-detail.perspective .term-detail-title { color: var(--pixel-purple); }
.term-detail.color .term-detail-title { color: var(--pixel-pink); }

.close-btn {
  font-family: var(--font-pixel);
  font-size: 0.5rem;
  background: none;
  border: 1px solid var(--border-mid);
  color: var(--text-muted);
  cursor: pointer;
  padding: 0.35rem 0.6rem;
  border-radius: 4px;
  transition: all 0.15s;
}
.close-btn:hover { border-color: var(--pixel-pink); color: var(--pixel-pink); }

.definition-box {
  background: var(--bg-card);
  border-left: 4px solid;
  border-radius: 0 8px 8px 0;
  padding: 0.9rem 1rem;
  margin-bottom: 1.25rem;
  font-size: 0.95rem;
  color: var(--text-strong);
  line-height: 1.65;
}
.term-detail.texture .definition-box { border-color: var(--pixel-orange); }
.term-detail.scale .definition-box { border-color: var(--pixel-cyan); }
.term-detail.perspective .definition-box { border-color: var(--pixel-purple); }
.term-detail.color .definition-box { border-color: var(--pixel-pink); }

/* BEFORE / AFTER TOGGLE */
.ba-section { margin-bottom: 1.25rem; }
.ba-label {
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 0.6rem;
}
.ba-toggle {
  display: flex;
  gap: 0;
  margin-bottom: 0.75rem;
  width: fit-content;
  border: 2px solid var(--border-mid);
  border-radius: 6px;
  overflow: hidden;
}
.ba-btn {
  font-family: var(--font-pixel);
  font-size: 0.45rem;
  padding: 0.45rem 0.85rem;
  border: none;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  line-height: 1.8;
  transition: all 0.15s;
}
.ba-btn.active { background: var(--border-mid); color: var(--text-strong); }
.ba-frame {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  aspect-ratio: 16/9;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.ba-placeholder {
  text-align: center;
  color: var(--text-muted);
  font-size: 0.8rem;
}
.ba-placeholder .icon { font-size: 2rem; margin-bottom: 0.5rem; }
.ba-placeholder .slot-label {
  font-family: var(--font-pixel);
  font-size: 0.4rem;
  line-height: 2;
  color: var(--border-mid);
}
.ba-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: none;
}
.ba-img.loaded { display: block; }

/* GALLERY */
.gallery-section { margin-bottom: 0.5rem; }
.gallery-label {
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 0.6rem;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.6rem;
}
.gallery-slot {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.15s;
  position: relative;
}
.gallery-slot:hover { border-color: var(--border-mid); }
.gallery-slot img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: none;
  image-rendering: pixelated;
}
.gallery-slot img.loaded { display: block; }
.gallery-slot-placeholder {
  text-align: center;
  color: var(--border-mid);
  font-size: 0.7rem;
}
.gallery-slot-placeholder .slot-icon { font-size: 1.3rem; margin-bottom: 0.25rem; }
.gallery-slot-placeholder .slot-num {
  font-family: var(--font-pixel);
  font-size: 0.38rem;
  line-height: 2;
}
.gallery-caption {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(1,46,64,0.85);
  font-size: 0.65rem;
  padding: 0.25rem 0.4rem;
  color: var(--text-muted);
  display: none;
}
.gallery-slot:hover .gallery-caption { display: block; }

/* ── STUB TABS ── */
.stub-message {
  text-align: center;
  padding: 3rem 1rem;
}
.stub-icon { font-size: 3rem; margin-bottom: 1rem; }
.stub-title {
  font-family: var(--font-pixel);
  font-size: 0.6rem;
  line-height: 1.8;
  color: var(--text-muted);
  margin-bottom: 0.75rem;
}
.stub-desc { font-size: 0.9rem; color: var(--text-muted); max-width: 420px; margin: 0 auto; }

.coming-soon-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  max-width: 520px;
  margin: 1.5rem auto 0;
}
.coming-card {
  background: var(--bg-card);
  border: 1px dashed var(--border-mid);
  border-radius: 8px;
  padding: 0.9rem;
  text-align: center;
}
.coming-card-label {
  font-family: var(--font-pixel);
  font-size: 0.42rem;
  line-height: 1.8;
  color: var(--text-muted);
  margin-bottom: 0.3rem;
}
.coming-card-icon { font-size: 1.3rem; }

/* ── TOOL CARDS ── */
.tools-section-label {
  font-family: var(--font-pixel);
  font-size: 0.5rem;
  line-height: 1.8;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 1.5rem 0 0.75rem 0;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid var(--border-subtle);
}
.tools-section-label:first-child { margin-top: 0; }

.tool-card {
  background: var(--bg-card);
  border: 2px solid var(--border-subtle);
  border-radius: 10px;
  padding: 1rem 1.1rem;
  margin-bottom: 0.65rem;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 0.85rem;
  align-items: start;
  transition: border-color 0.15s;
}
.tool-card:hover { border-color: var(--border-mid); }
.tool-card.primary { border-color: var(--pixel-cyan); }
.tool-card.gif-win { border-left: 3px solid var(--pixel-yellow); }
.tool-card.gif-mac { border-left: 3px solid var(--pixel-green); }
.tool-card.gif-linux { border-left: 3px solid var(--pixel-purple); }
.tool-card.pending { opacity: 0.6; border-style: dashed; }

.tool-icon-col { font-size: 1.6rem; padding-top: 0.1rem; }

.tool-info {}
.tool-name {
  font-family: var(--font-pixel);
  font-size: 0.5rem;
  line-height: 1.8;
  color: var(--text-strong);
  margin-bottom: 0.2rem;
}
.tool-card.primary .tool-name { color: var(--pixel-cyan); }
.tool-desc { font-size: 0.85rem; color: var(--text-body); line-height: 1.5; margin-bottom: 0.4rem; }
.tool-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
.tool-tag {
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  background: var(--bg-surface);
  border: 1px solid var(--border-mid);
  color: var(--text-muted);
}
.tool-tag.free { border-color: var(--pixel-green); color: var(--pixel-green); }
.tool-tag.browser { border-color: var(--pixel-cyan); color: var(--pixel-cyan); }
.tool-tag.win { border-color: var(--pixel-yellow); color: var(--pixel-yellow); }
.tool-tag.mac { border-color: var(--pixel-orange); color: var(--pixel-orange); }
.tool-tag.linux { border-color: var(--pixel-purple); color: var(--pixel-purple); }
.tool-tag.pending { border-color: var(--border-mid); color: var(--text-muted); font-style: italic; }
.tool-tag.source { border-color: var(--border-mid); color: var(--text-muted); }

.tool-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; min-width: 110px; }
.tool-link {
  font-family: var(--font-pixel);
  font-size: 0.4rem;
  line-height: 1.8;
  color: var(--pixel-cyan);
  text-decoration: none;
  background: rgba(91,188,214,0.08);
  border: 1px solid rgba(91,188,214,0.3);
  padding: 0.3rem 0.6rem;
  border-radius: 4px;
  transition: all 0.15s;
  white-space: nowrap;
}
.tool-link:hover { background: rgba(91,188,214,0.15); border-color: var(--pixel-cyan); }
.tool-link.disabled { color: var(--text-muted); background: none; border-color: var(--border-subtle); pointer-events: none; }
.tool-prompt {
  font-size: 0.72rem;
  color: var(--text-muted);
  font-style: italic;
  line-height: 1.4;
  text-align: right;
  max-width: 140px;
}
.tool-prompt strong { color: var(--pixel-yellow); font-style: normal; font-size: 0.65rem; display: block; margin-bottom: 0.15rem; }

.platform-note {
  background: var(--bg-surface);
  border-left: 3px solid var(--border-mid);
  border-radius: 0 6px 6px 0;
  padding: 0.6rem 0.85rem;
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-bottom: 1rem;
  line-height: 1.5;
}
.platform-note strong { color: var(--text-body); }

.pending-note {
  background: rgba(232,91,91,0.07);
  border: 1px dashed var(--pixel-orange);
  border-radius: 8px;
  padding: 0.75rem 1rem;
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-bottom: 1rem;
  line-height: 1.5;
}
.pending-note strong { color: var(--pixel-orange); }

/* ── SCALE EXAMPLE ── */
.scale-example-wrap { margin-bottom: 1rem; }
.scale-toggle-row { display: flex; gap: 0; margin-bottom: 0.75rem; width: fit-content; }
.scale-toggle-row .ba-btn { font-family: var(--font-pixel); font-size: 0.42rem; line-height: 1.8; }
.scale-panels { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
.scale-panel { flex: 1; min-width: 220px; }
.scale-scene-wrap { position: relative; display: inline-block; background: #1a2433; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 8px; }
.scale-scene-wrap canvas { image-rendering: pixelated; image-rendering: crisp-edges; display: block; }
.sc-label-layer { position: absolute; top: 8px; left: 8px; pointer-events: none; }
.sc-el-label { position: absolute; font-family: var(--font-body); font-size: 11px; font-weight: 700; color: #fff; background: rgba(0,0,0,0.72); padding: 1px 5px; border-radius: 3px; white-space: nowrap; display: none; }
.sc-labels-on .sc-el-label { display: block; }
